#!/bin/bash
# ~/.bashrc

[[ "$-" != *i* ]] && return

PS1='\[\e[31m\]\u\[\e[37m\]@\[\e[31m\]\h \[\e[33m\]\W \[\e[90m\]λ \[\e[39m\]'

HISTFILESIZE=10000
HISTCONTROL='erasedups'
HISTIGNORE=' *:..:~:ls:lsa:history:exit:clear:fg:fg *:s reboot:s poweroff'
PROMPT_COMMAND='history -a'
shopt -s histappend
shopt -s autocd

alias g='git'
alias vi='vis'
alias ls='ls --color=auto'
alias lsa='ls -A'
alias imv='nsxiv -a'
alias copy='xclip -se c'
alias wu='setxkbmap -layout us'
alias wc='setxkbmap -variant colemak -option caps:super'
alias lw='latexmk -pvc -pdf -view=none'
alias lc='latexmk -C'
alias bp='makepkg -si --rmdeps --clean'

s(){ su -c "${*@Q}"; }
unlock(){ gpg2 -q --for-your-eyes-only --no-tty -d "${1}"; }
bl() { su -c 'echo 0 > /sys/class/backlight/amdgpu_bl1/brightness'; }
bh() { su -c 'echo 100 > /sys/class/backlight/amdgpu_bl1/brightness'; }
bs() { su -c 'echo ${0} > /sys/class/backlight/amdgpu_bl1/brightness' root ${1}; }
lo() { su -c 'echo none > /sys/class/leds/platform::micmute/trigger'; }
wf() { su -c 'iwctl device wlan0 set-property Powered off'; }
wn() { su -c 'iwctl device wlan0 set-property Powered on'; }
eduroam() { su -c 'iwctl station wlan0 disconnect && sleep 1 && iwctl station wlan0 connect eduroam'; }

bash_history_file=$(mktemp "${USER}"_bash_historyXXXXXX)
tac "${HOME}/.bash_history" | awk '!x[$0]++' | tac > "${bash_history_file}"
mv "${bash_history_file}" "${HOME}/.bash_history"
unset bash_history_file
