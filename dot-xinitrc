#!/bin/bash
# ~/.xinitrc

[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

if [ -d /etc/X11/xinit/xinitrc.d ] ; then
 for f in /etc/X11/xinit/xinitrc.d/?*.sh ; do
  [ -x "$f" ] && . "$f"
 done
 unset f
fi

feh --bg-fill --no-fehbg "/mnt/phoebus/Images/Wallpapers/sky.jpg"

dt() { echo "   $(date +"%a, %b %d")"; }
tm() { echo "   $(date +"%I:%M %p")"; }
batt() {
  status=$(< "/sys/class/power_supply/AC/online")
  capacity=$(< "/sys/class/power_supply/BAT0/capacity")

  case "$status" in
    1 ) icon="🔌" ;;
    * ) icon="⚡" ;;
  esac

  echo "   $icon $capacity%"
}

while true; do
    xsetroot -name "$(batt)$(dt)$(tm)   "
    sleep 12
done &

redshift -l 42.5:-71 -b 1.0:0.6 &
exec dwm
