#!/bin/bash
# ~/.xinitrc

[ -f "$HOME/.Xresources" ] && xrdb -merge "$HOME/.Xresources"

if [ -d /etc/X11/xinit/xinitrc.d ] ; then
 for f in /etc/X11/xinit/xinitrc.d/?*.sh ; do
  [ -x "$f" ] && . "$f"
 done
 unset f
fi

feh --bg-fill --no-fehbg "/mnt/phoebus/Images/Wallpapers/sky.jpg"

dt() { echo "   $(date +"%a, %b %d")"; }
tm() { echo "   $(date +"%I:%M %p")"; }
batt() {
  status=$(cat /sys/class/power_supply/AC*/online 2>/dev/null)
  capacity=$(cat "/sys/class/power_supply/BAT0/capacity")

  case "$status" in
    1 ) icon="🔌" ;;
    * ) icon="⚡" ;;
  esac

  echo "   $icon $capacity%"
}
wifi() {
    interface="wlan0"

    operstate=$(cat /sys/class/net/"$interface"/operstate)
    has_ip=$(ip addr show "$interface" | grep -q "inet")

    if [[ "$operstate" != "down" && "$has_ip" -eq 0 ]]; then
        echo "    🌐 Wi-Fi"
    fi
}

while true; do
    xsetroot -name "$(wifi)$(batt)$(dt)$(tm)   "
    sleep 1
done &

redshift -l 42.5:-71 -b 1.0:0.6 &
exec dwm
